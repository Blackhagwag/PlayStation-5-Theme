{
  "name": "PlayStation 5",
  "description": "A PlayStation 5 shell for the Steam desktop client: PS5 Home Screen with your real games, Game Library, Control Center, PS5 game pages, a PS Store look for the store and wishlist, glass menus and smooth motion — every Steam function kept. Not affiliated with Sony Interactive Entertainment.",
  "author": "Blackhagwag",
  "version": "1.8.0",
  "source": "https://github.com/Blackhagwag/PlayStation-5-Theme",
  "github": {
    "owner": "Blackhagwag",
    "repo_name": "PlayStation-5-Theme"
  },
  "tags": [
    "Dark",
    "Console",
    "PlayStation",
    "Glass",
    "Animated",
    "Blue"
  ],
  "header_image": "https://raw.githubusercontent.com/Blackhagwag/PlayStation-5-Theme/HEAD/assets/real/header.jpg",
  "splash_image": "https://raw.githubusercontent.com/Blackhagwag/PlayStation-5-Theme/HEAD/assets/real/home.jpg",
  "RootColors": "css/root.css",
  "webkitCSS": "css/webkit/web.css",
  "webkitJS": "js/web.js",
  "UseDefaultPatches": false,
  "Patches": [
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": [
        "css/shared.css",
        "css/menus.css",
        "css/main.css",
        "css/components.css",
        "css/millennium.css"
      ],
      "TargetJs": "js/ps5.js"
    },
    {
      "MatchRegexString": ".DesktopUI",
      "TargetCss": [
        "css/shared.css",
        "css/menus.css",
        "css/millennium.css"
      ]
    },
    {
      "MatchRegexString": "ModalDialogBody",
      "TargetCss": [
        "css/shared.css",
        "css/menus.css",
        "css/millennium.css",
        "css/settings.css"
      ]
    },
    {
      "MatchRegexString": ".friendsui-container",
      "TargetCss": [
        "css/shared.css",
        "css/menus.css",
        "css/friends.css"
      ],
      "TargetJs": "js/friends.js"
    },
    {
      "MatchRegexString": "ContextMenuPopupBody",
      "TargetCss": [
        "css/shared.css",
        "css/menus.css"
      ]
    },
    {
      "MatchRegexString": "Menu$",
      "TargetCss": [
        "css/shared.css",
        "css/menus.css"
      ]
    },
    {
      "MatchRegexString": "Supernav$",
      "TargetCss": [
        "css/shared.css",
        "css/menus.css"
      ]
    },
    {
      "MatchRegexString": "DesktopToastContainer",
      "TargetCss": [
        "css/shared.css",
        "css/toasts.css"
      ]
    },
    {
      "MatchRegexString": "^notificationtoasts_",
      "TargetCss": [
        "css/shared.css",
        "css/toasts.css"
      ]
    },
    {
      "MatchRegexString": ".ModalDialogPopup",
      "TargetCss": [
        "css/shared.css",
        "css/menus.css",
        "css/millennium.css",
        "css/settings.css"
      ]
    },
    {
      "MatchRegexString": ".FullModalOverlay",
      "TargetCss": [
        "css/shared.css",
        "css/menus.css",
        "css/millennium.css"
      ]
    },
    {
      "MatchRegexString": "^(تسجيل الدخول إلى Steam|Iniciar a sessão no Steam|Вписване в Steam|Přihlášení do služby Steam|Log på Steam|Aanmelden bij Steam|Sign in to Steam|Kirjaudu Steamiin|Se connecter à Steam|Bei Steam anmelden|Σύνδεση στο Steam|Bejelentkezés a Steambe|Login ke Steam|Accedi a Steam|Steamにサインイン|Steam 로그인|Iniciar sesión en Steam|Daftar masuk ke Steam|Logg inn på Steam|Zaloguj się do Steam|Iniciar sessão no Steam|Conectează-te la Steam|Войти в Steam|登录 Steam|登录蒸汽平台|Logga in på Steam|登入 Steam|เข้าสู่ระบบ Steam|Steam'e Giriş Yap|Вхід до Steam|Đăng nhập vào Steam)$",
      "TargetCss": [
        "css/shared.css",
        "css/login.css"
      ]
    }
  ],
  "Conditions": {
    "Home Screen": {
      "description": "The PS5 Home Screen on top of the library home: your recently played games in a row, the selected game's art behind everything, Play, the \"…\" game menu and activity cards. Steam's own shelves stay below it.",
      "tab": "Home Screen",
      "section": "Layout",
      "default": "PlayStation 5",
      "values": {
        "PlayStation 5": {},
        "Steam default": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/home-off.css"
          }
        }
      }
    },
    "Home games": {
      "description": "Which games fill the row: what is installed on this PC, or everything in your library.",
      "tab": "Home Screen",
      "section": "Layout",
      "default": "Recently played (installed)",
      "values": {
        "Recently played (installed)": {},
        "Recently played (whole library)": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/home-all.css"
          }
        }
      }
    },
    "Game list on Home": {
      "description": "Steam's game list on the left. PS5 mode hides it on the Home Screen and on game pages, so a game opens as one full page; the Game Library (grid button or Ctrl+Shift+L) lists every game.",
      "tab": "Home Screen",
      "section": "Layout",
      "default": "Hidden on Home and game pages",
      "values": {
        "Hidden on Home and game pages": {},
        "Hidden on Home only": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/sidebar-home-only.css"
          }
        },
        "Always visible": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/sidebar-home-show.css"
          }
        }
      }
    },
    "Home art blur": {
      "description": "How soft the selected game's art behind the Home Screen is. A light blur keeps it recognisable and the text easy to read; 0 is sharp.\n[i]Default: 10px[/i]",
      "tab": "Home Screen",
      "section": "Background",
      "default": 10,
      "slider": {
        "cssVariable": "--ps5-art-blur",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px"
      }
    },
    "Steam shelves under Home": {
      "description": "Steam's own shelves (recent games, your collections) under the PS5 Home Screen.",
      "tab": "Home Screen",
      "section": "Steam shelves",
      "default": "Show",
      "values": {
        "Show": {},
        "Hide": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/shelves-hide.css"
          }
        }
      }
    },
    "What's New": {
      "description": "Steam's What's New shelf as PS5 content cards, or hidden.",
      "tab": "Home Screen",
      "section": "Steam shelves",
      "default": "PS5 cards",
      "values": {
        "PS5 cards": {},
        "Hidden": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/whatsnew-hide.css"
          }
        }
      }
    },
    "Accent color": {
      "description": "Highlight colour for buttons, focus, discounts and progress bars, in every window and on Steam's web pages. \"Colors tab\" uses the Accent from this theme's Colors tab.",
      "tab": "Look",
      "section": "Colours",
      "default": "Colors tab",
      "values": {
        "Colors tab": {},
        "Cosmic Red": {
          "TargetCss": {
            "affects": [
              "^Steam$",
              ".DesktopUI",
              ".friendsui-container",
              "Menu$",
              "Supernav$",
              "^notificationtoasts_",
              "ContextMenuPopupBody",
              "ModalDialogBody",
              "DesktopToastContainer",
              ".ModalDialogPopup",
              ".FullModalOverlay",
              "https://(store\\.steampowered\\.com|steamcommunity\\.com)(/.*)?"
            ],
            "src": "css/options/accent-red.css"
          }
        },
        "Nova Pink": {
          "TargetCss": {
            "affects": [
              "^Steam$",
              ".DesktopUI",
              ".friendsui-container",
              "Menu$",
              "Supernav$",
              "^notificationtoasts_",
              "ContextMenuPopupBody",
              "ModalDialogBody",
              "DesktopToastContainer",
              ".ModalDialogPopup",
              ".FullModalOverlay",
              "https://(store\\.steampowered\\.com|steamcommunity\\.com)(/.*)?"
            ],
            "src": "css/options/accent-pink.css"
          }
        },
        "Galactic Purple": {
          "TargetCss": {
            "affects": [
              "^Steam$",
              ".DesktopUI",
              ".friendsui-container",
              "Menu$",
              "Supernav$",
              "^notificationtoasts_",
              "ContextMenuPopupBody",
              "ModalDialogBody",
              "DesktopToastContainer",
              ".ModalDialogPopup",
              ".FullModalOverlay",
              "https://(store\\.steampowered\\.com|steamcommunity\\.com)(/.*)?"
            ],
            "src": "css/options/accent-purple.css"
          }
        },
        "Starlight Blue": {
          "TargetCss": {
            "affects": [
              "^Steam$",
              ".DesktopUI",
              ".friendsui-container",
              "Menu$",
              "Supernav$",
              "^notificationtoasts_",
              "ContextMenuPopupBody",
              "ModalDialogBody",
              "DesktopToastContainer",
              ".ModalDialogPopup",
              ".FullModalOverlay",
              "https://(store\\.steampowered\\.com|steamcommunity\\.com)(/.*)?"
            ],
            "src": "css/options/accent-starlight.css"
          }
        },
        "Volcanic Orange": {
          "TargetCss": {
            "affects": [
              "^Steam$",
              ".DesktopUI",
              ".friendsui-container",
              "Menu$",
              "Supernav$",
              "^notificationtoasts_",
              "ContextMenuPopupBody",
              "ModalDialogBody",
              "DesktopToastContainer",
              ".ModalDialogPopup",
              ".FullModalOverlay",
              "https://(store\\.steampowered\\.com|steamcommunity\\.com)(/.*)?"
            ],
            "src": "css/options/accent-orange.css"
          }
        }
      }
    },
    "Background": {
      "description": "What sits behind the glass in the main window when no game art is shown.",
      "tab": "Look",
      "section": "Background",
      "default": "Game art",
      "values": {
        "Game art": {},
        "PS5 ambient waves": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/bg-waves.css"
          }
        },
        "Pure black": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/bg-black.css"
          }
        }
      }
    },
    "Animations": {
      "description": "Full: PS5 motion for cards, panels, menus and the background. Reduced: near-instant, for slower PCs.",
      "tab": "Look",
      "section": "Motion",
      "default": "Full",
      "values": {
        "Full": {},
        "Reduced": {
          "TargetCss": {
            "affects": [
              "^Steam$",
              ".DesktopUI",
              ".friendsui-container",
              "Menu$",
              "Supernav$",
              "^notificationtoasts_",
              "ContextMenuPopupBody",
              "ModalDialogBody",
              "DesktopToastContainer",
              ".ModalDialogPopup",
              ".FullModalOverlay"
            ],
            "src": "css/options/motion-reduced.css"
          }
        }
      }
    },
    "Boot animation": {
      "description": "The short PS5-style fade when the Steam window opens.",
      "tab": "Look",
      "section": "Motion",
      "default": "On",
      "values": {
        "On": {},
        "Off": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/boot-off.css"
          }
        }
      }
    },
    "Clock": {
      "description": "The clock in the top-right corner, as on the PS5.",
      "tab": "Bars",
      "section": "Top bar",
      "default": "24-hour",
      "values": {
        "24-hour": {},
        "12-hour": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/clock-12.css"
          }
        },
        "Hidden": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/clock-off.css"
          }
        }
      }
    },
    "Steam account button": {
      "description": "Steam's own account button. Hidden: the PS5 avatar is the single profile button — status, wallet, account details, store preferences and change account are in its panel (Control Center → Profile).",
      "tab": "Bars",
      "section": "Top bar",
      "default": "Hidden (PS5 profile)",
      "values": {
        "Hidden (PS5 profile)": {},
        "Visible": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/account-show.css"
          }
        }
      }
    },
    "Privacy blur": {
      "description": "Blurs your wallet balance (in the PS5 profile panel and in Steam's account button) until you hover it — for streams and screenshots.",
      "tab": "Bars",
      "section": "Top bar",
      "default": "Off",
      "values": {
        "Off": {},
        "On": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/privacy-blur.css"
          }
        }
      }
    },
    "Steam news button": {
      "description": "Steam's news (megaphone) button in the top bar.",
      "tab": "Bars",
      "section": "Top bar",
      "default": "Visible",
      "values": {
        "Visible": {},
        "Hidden": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/news-hide.css"
          }
        }
      }
    },
    "Bottom bar": {
      "description": "Add a Game, Downloads (with live progress) and Friends & Chat as compact PS5 capsules, or Steam's own look.",
      "tab": "Bars",
      "section": "Bottom bar",
      "default": "PS5",
      "values": {
        "PS5": {},
        "Steam default": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/bottombar-steam.css"
          }
        }
      }
    },
    "Offline friends": {
      "description": "The Offline group of the friends list: Steam's rows, or a grid of round faces (the name shows on hover).",
      "tab": "Friends",
      "section": "Friends list",
      "default": "List",
      "values": {
        "List": {},
        "Faces": {
          "TargetCss": {
            "affects": [
              ".friendsui-container"
            ],
            "src": "css/options/friends-faces.css"
          }
        }
      }
    },
    "Store and Community": {
      "description": "PS5 design for the Store (home, game pages with the PS Store header, search, wishlist grid), Workshop, discussions and the rest of the Community. User profiles always stay as Steam draws them. Steam default leaves every web page untouched.",
      "tab": "Store & Web",
      "section": "Store and Community",
      "default": "PS5 style",
      "values": {
        "PS5 style": {},
        "Steam default": {
          "TargetCss": {
            "affects": [
              "https://(store\\.steampowered\\.com|steamcommunity\\.com|checkout\\.steampowered\\.com)(/.*)?"
            ],
            "src": "css/options/web-off.css"
          }
        }
      }
    },
    "Theme language": {
      "description": "Language of the text the theme draws itself (Home Screen, Control Center, Game Library, store panels). Auto follows your system.",
      "tab": "Language",
      "section": "Language",
      "default": "Auto",
      "values": {
        "Auto": {},
        "English": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/lang-en.css"
          }
        },
        "Русский": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "css/options/lang-ru.css"
          }
        }
      }
    }
  }
}
